APP_NAME="Campus Shuttle Tracking API"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campus_shuttle
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change_this_secret_key_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=*

DEFAULT_AVERAGE_SPEED_MPH=20
MIN_VALID_SPEED_MPH=1
MAX_VALID_SPEED_MPH=65
SPEED_SAMPLE_SIZE=10
STALE_LOCATION_SECONDS=60
OFFLINE_LOCATION_SECONDS=300
LIVE_STATE_TTL_SECONDS=900

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
